          "rawQuery": true,
          "rawSql": "SELECT q.period_id,q.period_start_utc,q.variant,q.deployment_label,q.captured_seconds,m.execution_count,m.execution_count/NULLIF(q.captured_seconds,0) AS executions_per_second,m.total_duration_ms/NULLIF(m.execution_count,0) AS avg_duration_ms,m.total_cpu_ms/NULLIF(m.execution_count,0) AS avg_cpu_ms,m.total_logical_reads,m.plan_count FROM qv_report.run_quality AS q INNER JOIN qv_report.period_metrics AS m ON m.period_id=q.period_id WHERE q.source_server_name=${server:sqlstring} AND q.source_database_name=${database:sqlstring} AND q.period_classification=N'Load test' AND q.experiment_name=${experiment:sqlstring} ORDER BY q.period_start_utc,q.period_id;",
