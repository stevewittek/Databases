          "rawQuery": true,
          "rawSql": "SELECT COUNT_BIG(*) AS regressed_queries FROM qv_report.fn_CompareRuns(TRY_CONVERT(int,${baseline:sqlstring}),TRY_CONVERT(int,${candidate:sqlstring})) WHERE match_state=N'MATCHED' AND baseline_executions>=TRY_CONVERT(int,${min_executions:sqlstring}) AND candidate_executions>=TRY_CONVERT(int,${min_executions:sqlstring}) AND avg_duration_delta_pct>=TRY_CONVERT(float,${regression_pct:sqlstring});",
