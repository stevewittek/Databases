{
  "uid": "qv-load-test-lab",
  "title": "QueryVault Load Test Lab",
  "description": "Archived Query Store analytics. Uses the stable qv_report contract. No live-source queries or tuning actions.",
  "tags": [
    "QueryVault",
    "Query Store",
    "Analytics"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "utc",
  "refresh": "",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "server",
        "label": "Source server",
        "type": "query",
        "datasource": {
          "type": "mssql",
          "uid": "queryvault-mssql"
        },
        "query": "SELECT DISTINCT source_server_name FROM qv_report.periods ORDER BY 1;",
        "definition": "SELECT DISTINCT source_server_name FROM qv_report.periods ORDER BY 1;",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "options": [],
        "current": {},
        "sort": 0,
        "hide": 0
      },
      {
        "name": "database",
        "label": "Database",
        "type": "query",
        "datasource": {
          "type": "mssql",
          "uid": "queryvault-mssql"
        },
        "query": "SELECT DISTINCT source_database_name FROM qv_report.periods WHERE source_server_name=${server:sqlstring} ORDER BY 1;",
        "definition": "SELECT DISTINCT source_database_name FROM qv_report.periods WHERE source_server_name=${server:sqlstring} ORDER BY 1;",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "options": [],
        "current": {},
        "sort": 0,
        "hide": 0
      },
      {
        "name": "experiment",
        "label": "Experiment",
        "type": "query",
        "datasource": {
          "type": "mssql",
          "uid": "queryvault-mssql"
        },
        "query": "SELECT DISTINCT experiment_name FROM qv_report.run_quality WHERE source_server_name=${server:sqlstring} AND source_database_name=${database:sqlstring} AND period_classification=N'Load test' AND experiment_name IS NOT NULL ORDER BY 1;",
        "definition": "SELECT DISTINCT experiment_name FROM qv_report.run_quality WHERE source_server_name=${server:sqlstring} AND source_database_name=${database:sqlstring} AND period_classification=N'Load test' AND experiment_name IS NOT NULL ORDER BY 1;",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "options": [],
        "current": {},
        "sort": 0,
        "hide": 0
      },
      {
        "name": "candidate",
        "label": "After / candidate run",
        "type": "query",
        "datasource": {
          "type": "mssql",
          "uid": "queryvault-mssql"
        },
        "query": "SELECT CONCAT('#',period_id,' | ',CONVERT(varchar(19),period_start_utc,120),' UTC | ',period_name, ' | ',COALESCE(variant,'')) AS __text, period_id AS __value FROM qv_report.run_quality WHERE source_server_name=${server:sqlstring} AND source_database_name=${database:sqlstring} AND period_start_utc <= $__timeTo() AND period_end_utc >= $__timeFrom() AND period_status=N'Completed' AND period_classification=N'Load test' AND experiment_name=${experiment:sqlstring} ORDER BY period_start_utc DESC,period_id DESC;",
        "definition": "SELECT CONCAT('#',period_id,' | ',CONVERT(varchar(19),period_start_utc,120),' UTC | ',period_name, ' | ',COALESCE(variant,'')) AS __text, period_id AS __value FROM qv_report.run_quality WHERE source_server_name=${server:sqlstring} AND source_database_name=${database:sqlstring} AND period_start_utc <= $__timeTo() AND period_end_utc >= $__timeFrom() AND period_status=N'Completed' AND period_classification=N'Load test' AND experiment_name=${experiment:sqlstring} ORDER BY period_start_utc DESC,period_id DESC;",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "options": [],
        "current": {},
        "sort": 0,
        "hide": 0
      },
      {
        "name": "baseline",
        "label": "Before / baseline run",
        "type": "query",
        "datasource": {
          "type": "mssql",
          "uid": "queryvault-mssql"
        },
        "query": "SELECT CONCAT('#',period_id,' | ',CONVERT(varchar(19),period_start_utc,120),' UTC | ',period_name, ' | ',COALESCE(variant,'')) AS __text, period_id AS __value FROM qv_report.run_quality WHERE source_server_name=${server:sqlstring} AND source_database_name=${database:sqlstring} AND period_start_utc <= $__timeTo() AND period_end_utc >= $__timeFrom() AND period_status=N'Completed' AND period_classification=N'Load test' AND experiment_name=${experiment:sqlstring} AND period_id<>TRY_CONVERT(int,${candidate:sqlstring}) AND captured_end_utc<=(SELECT captured_start_utc FROM qv_report.run_quality WHERE period_id=TRY_CONVERT(int,${candidate:sqlstring})) ORDER BY period_start_utc DESC,period_id DESC;",
        "definition": "SELECT CONCAT('#',period_id,' | ',CONVERT(varchar(19),period_start_utc,120),' UTC | ',period_name, ' | ',COALESCE(variant,'')) AS __text, period_id AS __value FROM qv_report.run_quality WHERE source_server_name=${server:sqlstring} AND source_database_name=${database:sqlstring} AND period_start_utc <= $__timeTo() AND period_end_utc >= $__timeFrom() AND period_status=N'Completed' AND period_classification=N'Load test' AND experiment_name=${experiment:sqlstring} AND period_id<>TRY_CONVERT(int,${candidate:sqlstring}) AND captured_end_utc<=(SELECT captured_start_utc FROM qv_report.run_quality WHERE period_id=TRY_CONVERT(int,${candidate:sqlstring})) ORDER BY period_start_utc DESC,period_id DESC;",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "options": [],
        "current": {},
        "sort": 0,
        "hide": 0
      },
      {
        "name": "min_executions",
        "label": "Minimum executions each run",
        "type": "custom",
        "query": "10,1,50,100,1000",
        "options": [],
        "current": {
          "text": "10",
          "value": "10"
        },
        "multi": false,
        "includeAll": false
      },
      {
        "name": "regression_pct",
        "label": "Regression threshold %",
        "type": "custom",
        "query": "20,10,30,50,100",
        "options": [],
        "current": {
          "text": "20",
          "value": "20"
        },
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "title": "Read this comparison",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Choose the date range, source and two run IDs. **After minus before** is used for deltas. Rates use captured Query Store interval time. Average latency identifies slower executions; totals also reflect frequency. Identity continuity is operator-confirmed only when both runs share a recorded epoch. New or absent queries are not scored as regressions. Plan inventory changes are investigation leads, not proof of cause. No percentiles are inferred from aggregate Query Store data."
      },
      "id": 1
    },
    {
      "title": "Comparison readiness",
      "type": "table",
      "datasource": {
        "type": "mssql",
        "uid": "queryvault-mssql"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "query_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Inspect candidate query timeline",
                    "url": "/d/qv-interval-investigation/queryvault-interval-investigation?var-server=${server:percentencode}&var-database=${database:percentencode}&var-run=${candidate:percentencode}&var-query=${__data.fields.query_id}&from=${__from}&to=${__to}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "queryvault-mssql"
          },
          "editorMode": "code",
          "rawQuery": true,
          "rawSql": "SELECT comparison_state,identity_confidence,unequal_windows,same_experiment,time_direction,baseline_wait_state,candidate_wait_state FROM qv_report.fn_CompareRunQuality(TRY_CONVERT(int,${baseline:sqlstring}),TRY_CONVERT(int,${candidate:sqlstring}));",
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 2
